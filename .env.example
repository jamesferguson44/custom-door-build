SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Sends the "new quote submitted" email to the business. Free tier at resend.com
# (no credit card needed). Leave blank to skip email notifications — the quote
# will still save to the database either way.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Pane & Simple <[email protected]>"
NOTIFY_TO_EMAIL="[email protected]"

# Cloudflare Turnstile (spam protection on the quote form). Free — create a
# widget at https://dash.cloudflare.com/?to=/:account/turnstile. Leave blank
# to skip verification (form still works, just unprotected from bots).
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
